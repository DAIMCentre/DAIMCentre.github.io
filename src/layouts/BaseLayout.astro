---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../data/site';

interface Props {
  /** Page title, without the site suffix. Omit on the homepage. */
  title?: string;
  description: string;
  /** Overrides the default social sharing image. */
  ogImage?: string;
  /** Set on pages that should not be indexed. */
  noindex?: boolean;
}

const { title, description, ogImage = SITE.ogImage, noindex = false } =
  Astro.props;

const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;

// GitHub Pages serves directory-format output and 301s `/x` → `/x/`, and the
// sitemap emits the trailing-slash form. Canonicals must match, or the two
// disagree about which URL is authoritative.
const pathname = Astro.url.pathname;
const canonicalPath = /\.[a-z0-9]+$/i.test(pathname)
  ? pathname
  : pathname.replace(/\/*$/, '/');

const canonical = new URL(canonicalPath, Astro.site ?? SITE.url).href;

const ogImageUrl = new URL(ogImage, Astro.site ?? SITE.url).href;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {/* No canonical on noindex pages — /404 has no crawlable URL to point at. */}
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}

    {/* Official DAIM mark, cropped and resized from brand/DAIM_W.png */}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
