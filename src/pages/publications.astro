---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import LinkOrPlaceholder from '../components/LinkOrPlaceholder.astro';
import { RESEARCH_AREAS } from '../data/research-areas';
import { LINKS } from '../data/site';

const entries = (await getCollection('publications'))
  .filter((p) => !p.data.draft)
  .sort(
    (a, b) =>
      b.data.year - a.data.year ||
      a.data.title.localeCompare(b.data.title)
  );

/** Group by year, newest first. */
const groups = new Map<number, typeof entries>();
for (const e of entries) {
  const bucket = groups.get(e.data.year);
  if (bucket) bucket.push(e);
  else groups.set(e.data.year, [e]);
}
const orderedGroups = [...groups.entries()].sort(([a], [b]) => b - a);

const areaTitle = (id: string) =>
  RESEARCH_AREAS.find((a) => a.id === id)?.title ?? id;

const types = [...new Set(entries.map((e) => e.data.type))].sort();

/* Themes offered by the filter: only those that actually appear on an entry,
   kept in the order they are defined in src/data/research-areas.ts so the
   filter reads the same way as /research. */
const themeCounts = new Map<string, number>();
for (const e of entries) {
  for (const a of e.data.areas) {
    themeCounts.set(a, (themeCounts.get(a) ?? 0) + 1);
  }
}
const themes = RESEARCH_AREAS.filter((a) => themeCounts.has(a.id)).map((a) => ({
  id: a.id,
  title: a.title,
  count: themeCounts.get(a.id) ?? 0,
}));

type PubData = (typeof entries)[number]['data'];

const linksFor = (d: PubData) =>
  [
    d.doi ? { label: 'DOI', href: `https://doi.org/${d.doi}` } : null,
    d.url ? { label: 'Publisher', href: d.url } : null,
    d.arxivUrl ? { label: 'arXiv', href: d.arxivUrl } : null,
    d.pdfUrl ? { label: 'PDF', href: d.pdfUrl } : null,
    d.codeUrl ? { label: 'Code', href: d.codeUrl } : null,
  ].filter((x): x is { label: string; href: string } => x !== null);

/**
 * Split the author list so DAIM-affiliated names can be emphasised, which is
 * the normal convention for a centre publication list.
 */
const authorParts = (d: PubData) =>
  d.authors.map((name) => ({
    name,
    isDaim: d.daimAuthors.includes(name),
  }));
---

<BaseLayout
  title="Publications"
  description="Peer-reviewed papers, conference papers and preprints from researchers at DAIM, the Centre of Excellence for Data Science, Artificial Intelligence and Modelling, University of Hull."
>
  <PageHeader
    eyebrow="Publications"
    title="Publications"
    lede="Papers, conference contributions and preprints from researchers working with DAIM."
  />

  <section class="section">
    <div class="container">
      {
        entries.length > 0 ? (
          <>
            <div class="pub-meta">
              <div>
                <p class="meta pub-meta__label">Entries</p>
                <p class="pub-meta__value" data-count>{entries.length}</p>
              </div>
              <div>
                <p class="meta pub-meta__label">Years</p>
                <p class="pub-meta__value">
                  {orderedGroups.length > 1
                    ? `${orderedGroups[orderedGroups.length - 1][0]}–${orderedGroups[0][0]}`
                    : String(orderedGroups[0][0])}
                </p>
              </div>
              <div>
                <p class="meta pub-meta__label">Types</p>
                <p class="pub-meta__value">{types.join(', ')}</p>
              </div>
            </div>

            {/* Progressive enhancement: hidden until the inline script turns
                it on, so with JavaScript off the page is the full list rather
                than a row of dead buttons. */}
            {themes.length > 1 && (
              <div class="filter" id="filter" hidden>
                <p class="meta filter__label" id="filter-label">
                  Filter by theme
                </p>
                <div
                  class="filter__row"
                  role="group"
                  aria-labelledby="filter-label"
                >
                  <button
                    class="chip"
                    type="button"
                    data-key="*"
                    aria-pressed="true"
                  >
                    All <span class="chip__n">{entries.length}</span>
                  </button>
                  {themes.map((t) => (
                    <button
                      class="chip"
                      type="button"
                      data-key={t.id}
                      aria-pressed="false"
                    >
                      {t.title} <span class="chip__n">{t.count}</span>
                    </button>
                  ))}
                </div>
              </div>
            )}

            {orderedGroups.map(([year, items]) => (
              <section class="pub-group" data-year-group>
                <h2 class="pub-group__title meta">{year}</h2>
                <ul class="list-plain pub-list">
                  {items.map((e) => {
                    const links = linksFor(e.data);
                    const authors = authorParts(e.data);
                    return (
                      <li
                        class="pub"
                        id={e.id}
                        data-areas={e.data.areas.join('|')}
                      >
                        <div class="pub__aside">
                          <p class="meta">{e.data.type}</p>
                        </div>

                        <div class="pub__body">
                          <h3 class="h-sub pub__title">{e.data.title}</h3>

                          {authors.length > 0 && (
                            <p class="pub__authors">
                              {authors.map((a, i) => (
                                <>
                                  {i > 0 && ', '}
                                  {a.isDaim ? <strong>{a.name}</strong> : a.name}
                                </>
                              ))}
                              {e.data.totalAuthors &&
                                e.data.totalAuthors > authors.length &&
                                ` and ${e.data.totalAuthors - authors.length} others`}
                            </p>
                          )}

                          {e.data.venue && (
                            <p class="pub__venue">
                              {/* kept on one line: a newline here renders as a space before the comma */}
                              <em>{e.data.venue}</em>{e.data.venueDetail ? `, ${e.data.venueDetail}` : ''}
                            </p>
                          )}

                          {e.data.areas.length > 0 && (
                            <ul class="tags pub__tags">
                              {e.data.areas.map((a) => (
                                <li class="tag">{areaTitle(a)}</li>
                              ))}
                            </ul>
                          )}

                          {links.length > 0 && (
                            <ul class="list-plain pub__links">
                              {links.map((l) => (
                                <li>
                                  <a class="link" href={l.href} rel="noopener">
                                    {l.label}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          )}
                        </div>
                      </li>
                    );
                  })}
                </ul>
              </section>
            ))}

            <p class="no-match" id="no-match" hidden>
              Nothing in the list carries that theme. Clear the filter to see
              all {entries.length}.
            </p>
          </>
        ) : (
          <div class="coming-soon">
            <p class="meta coming-soon__label">Being compiled</p>
            <h2 class="h-section coming-soon__title">
              The publication list is not up yet
            </h2>
            <div class="prose coming-soon__body">
              <p>
                The list is built from the ORCID records of researchers working
                with DAIM. Nothing has been added yet.
              </p>
              <p>
                In the meantime, publications by DAIM researchers are listed on
                the{' '}
                <LinkOrPlaceholder
                  link={LINKS.officialPage}
                  class="link"
                  label="University of Hull DAIM page"
                />
                .
              </p>
            </div>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var filter = document.getElementById('filter');
    if (!filter) return;

    var cards = Array.prototype.slice.call(document.querySelectorAll('.pub'));
    var groups = Array.prototype.slice.call(
      document.querySelectorAll('[data-year-group]')
    );
    var chips = Array.prototype.slice.call(filter.querySelectorAll('.chip'));
    var count = document.querySelector('[data-count]');
    var noMatch = document.getElementById('no-match');

    function apply(key) {
      var shown = 0;
      cards.forEach(function (card) {
        var keys = (card.getAttribute('data-areas') || '').split('|');
        var match = key === '*' || keys.indexOf(key) !== -1;
        card.hidden = !match;
        if (match) shown++;
      });
      // A year heading with nothing left under it is just noise.
      groups.forEach(function (g) {
        var any = Array.prototype.some.call(
          g.querySelectorAll('.pub'),
          function (c) {
            return !c.hidden;
          }
        );
        g.hidden = !any;
      });
      chips.forEach(function (chip) {
        chip.setAttribute(
          'aria-pressed',
          chip.getAttribute('data-key') === key ? 'true' : 'false'
        );
      });
      if (count) count.textContent = String(shown);
      if (noMatch) noMatch.hidden = shown !== 0;
    }

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        // Clicking the active theme again clears the filter.
        var key = chip.getAttribute('data-key');
        apply(chip.getAttribute('aria-pressed') === 'true' ? '*' : key);
      });
    });

    filter.hidden = false;
    apply('*');
  })();
</script>

<style>

  /* ------------------------------------------------------------- filter -- */

  .filter {
    padding-block: 1.5rem 1.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .filter__label {
    margin: 0 0 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    font-size: 0.6875rem;
  }

  .filter__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .chip {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--ink-2);
    background: var(--paper);
    border: 1px solid var(--rule-strong);
    padding: 0.35rem 0.6rem;
    cursor: pointer;
    transition: background-color 0.12s ease, color 0.12s ease,
      border-color 0.12s ease;
  }

  .chip:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .chip[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .chip__n {
    opacity: 0.55;
    margin-left: 0.3rem;
  }

  .chip[aria-pressed='true'] .chip__n {
    opacity: 0.7;
  }

  /* `.pub` sets its own display, which out-specifies the browser's [hidden]
     rule, so a filtered-out entry needs this to actually disappear. */
  .pub[hidden],
  .pub-group[hidden] {
    display: none;
  }

  .no-match {
    margin-top: 2rem;
    color: var(--ink-2);
    max-width: 62ch;
  }
  .pub-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .pub-meta p {
    margin: 0;
  }

  .pub-meta__label {
    text-transform: uppercase;
    letter-spacing: 0.11em;
    font-size: 0.6875rem;
    margin-bottom: 0.4rem;
  }

  .pub-meta__value {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--ink);
  }

  .pub-group {
    margin-top: 2.5rem;
  }

  .pub-group__title {
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--ink-3);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .pub {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding-block: clamp(1.5rem, 3vw, 2rem);
    border-bottom: 1px solid var(--rule);
    align-items: start;
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .pub__aside p {
    margin: 0;
  }

  .pub__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pub__title {
    margin: 0;
    max-width: 46ch;
  }

  .pub__authors {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.9375rem;
    max-width: 68ch;
  }

  .pub__authors strong {
    color: var(--ink);
    font-weight: 600;
  }

  .pub__venue {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .pub__tags,
  .pub__links {
    margin-top: 0.25rem;
  }

  .pub__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    font-size: 0.875rem;
  }

  .coming-soon {
    border: 1px dashed var(--rule-strong);
    padding: clamp(1.75rem, 4vw, 2.75rem);
    max-width: 62ch;
  }

  .coming-soon__label {
    margin: 0 0 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-size: 0.6875rem;
  }

  .coming-soon__title {
    margin-bottom: 1rem;
  }

  .coming-soon__body {
    font-size: 0.9375rem;
  }

  @media (max-width: 700px) {
    .pub-meta {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
    .pub {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
    }
  }
</style>
